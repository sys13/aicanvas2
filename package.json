{
	"name": "aicanvas-2",
	"version": "0.2.2",
	"description": "Official Maxstack web application template",
	"private": false,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"db:generate": "dotenvx run -- drizzle-kit generate",
		"db:migrate": "dotenvx run -- drizzle-kit migrate",
		"db:studio": "dotenvx run -- drizzle-kit studio",
		"db:seed": "dotenvx run -- tsx scripts/seed.ts",
		"db:reset": "dotenvx run -- tsx scripts/reset-db.ts",
		"db:push": "dotenvx run -- drizzle-kit push",
		"dev": "MOCKS=true react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"gen:routes": "dotenvx run -- tsx scripts/gen-routes.ts",
		"typecheck": "react-router typegen && tsc",
		"lint": "biome check --write",
		"spell-check": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"spell-check:fix": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\" --config cspell.json",
		"validate": "pnpm run typecheck && pnpm run lint && pnpm run test:run && pnpm run test:e2e",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:ui": "playwright test --ui",
		"coverage": "vitest run --coverage",
		"deploy:digitalocean": "dotenvx run -- tsx scripts/deploy-digitalocean.ts"
	},
	"dependencies": {
		"@ai-sdk/openai": "^2.0.80",
		"@dotenvx/dotenvx": "^1.51.1",
		"@faker-js/faker": "^10.1.0",
		"@libsql/client": "^0.15.15",
		"@paralleldrive/cuid2": "^3.1.0",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-email/components": "^1.0.1",
		"@react-router/node": "^7.10.1",
		"@react-router/serve": "^7.10.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bcryptjs": "^3.0.0",
		"ai": "^5.0.108",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.4.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"digitalocean": "^1.2.1",
		"drizzle-orm": "1.0.0-beta.2-b782ae1",
		"fs-extra": "^11.3.2",
		"isbot": "^5.1.32",
		"lucide-react": "^0.555.0",
		"maxstack-core": "*",
		"msw": "^2.12.4",
		"node-ssh": "^13.2.1",
		"nodemailer": "^7.0.11",
		"react": "^19.2.1",
		"react-day-picker": "^9.11.3",
		"react-dom": "^19.2.1",
		"react-router": "^7.10.1",
		"resend": "^6.5.2",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@playwright/test": "^1.57.0",
		"@react-router/dev": "^7.10.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.10.1",
		"@types/nodemailer": "^7.0.4",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "4.0.15",
		"@vitest/ui": "4.0.15",
		"cspell": "^9.4.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "1.0.0-beta.2-b782ae1",
		"jsdom": "^27.2.0",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.15"
	},
	"files": [
		"**/*",
		"!node_modules/**",
		"!.git/**",
		".gitignore"
	],
	"keywords": [
		"maxstack",
		"template",
		"react-router",
		"starter"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sys13/max.git"
	},
	"author": "sys13 <>",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	}
}
